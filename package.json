{
  "name": "@royaltieshq/medusa-royalties-hq",
  "version": "0.1.3",
  "description": "Royalties HQ for Medusa v2: monthly, tax-free, net-receipts sales snapshots of your book sales, sent to Royalties HQ.",
  "author": "Consilience Media Limited",
  "license": "LicenseRef-PolyForm-Shield-1.0.0",
  "homepage": "https://royaltieshq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/consilience/medusa-royalties-hq.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".medusa/server",
    "!.medusa/server/**/__tests__",
    "!.medusa/server/dev",
    "!.medusa/server/integration-tests",
    "!.medusa/server/tests",
    "!.medusa/server/scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./.medusa/server/src/modules/royaltiesHq": "./.medusa/server/src/modules/royaltiesHq/index.js",
    "./modules/royaltiesHq": {
      "types": "./.medusa/server/src/modules/royaltiesHq/index.d.ts",
      "default": "./.medusa/server/src/modules/royaltiesHq/index.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa-v2",
    "medusa-plugin",
    "medusa-plugin-integration",
    "royalties",
    "books",
    "publishing"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin/tsconfig.json",
    "prepublishOnly": "medusa plugin:build",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:http": "npm run build && TEST_TYPE=integration:http NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=4096' jest --silent=false --runInBand --forceExit",
    "test:e2e": "TEST_TYPE=e2e NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "check:repo": "node scripts/check-repo.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:tarball": "node scripts/check-tarball.mjs"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.22.3",
    "@medusajs/cli": "2.22.3",
    "@medusajs/draft-order": "2.22.3",
    "@medusajs/eslint-plugin": "2.22.3",
    "@medusajs/framework": "2.22.3",
    "@medusajs/icons": "2.22.3",
    "@medusajs/js-sdk": "2.22.3",
    "@medusajs/medusa": "2.22.3",
    "@medusajs/test-utils": "2.22.3",
    "@medusajs/ui": "4.2.10",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.39",
    "@tanstack/react-query": "5.64.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jiti": "^2.0.0",
    "pg-god": "^1.0.12",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53",
    "yaml": "^2.6.1"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.22.0",
    "@medusajs/framework": "^2.22.0",
    "@medusajs/icons": "^2.22.0",
    "@medusajs/js-sdk": "^2.22.0",
    "@medusajs/medusa": "^2.22.0",
    "@medusajs/ui": "^4.2.0",
    "@tanstack/react-query": "^5.64.2"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "npm@10.9.8"
}
